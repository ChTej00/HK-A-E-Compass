# Copy this file to .env (which git ignores). Never commit a real key.

# Which AI model the agent uses: "ollama" (free, runs on this computer) or "anthropic" (paid API).
AECOMPASS_PROVIDER=ollama
# The model within that provider. Ollama: any model you have pulled that supports tools.
AECOMPASS_MODEL=qwen3:4b

# Only needed when AECOMPASS_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key-here
