{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": ["-m", "uvicorn", "aecompass.api.app:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": ["-m", "streamlit", "run", "src/aecompass/web/app.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501
    }
  ]
}
